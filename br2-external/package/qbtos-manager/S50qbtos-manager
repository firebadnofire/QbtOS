#!/bin/sh

DAEMON="qbtos-manager"
PIDFILE="/var/run/$DAEMON.pid"

case "$1" in
	start)
		printf '%s\n' 'Starting qbtOS HTTPS manager...'
		start-stop-daemon -S -q -b -m -p "$PIDFILE" \
			-x /usr/sbin/qbtos-manager
		;;
	stop)
		start-stop-daemon -K -q -p "$PIDFILE" || true
		rm -f "$PIDFILE"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

config BR2_PACKAGE_QBTOS_MANAGER
	bool "qbtOS management service"
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_IPROUTE2
	select BR2_PACKAGE_GIT
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBCURL_FORCE_TLS
	select BR2_PACKAGE_LIBOPENSSL_BIN
	select BR2_PACKAGE_NFTABLES
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_QBTOS_CA
	select BR2_PACKAGE_NFS_UTILS
	select BR2_PACKAGE_NFS_UTILS_NFSV4
	select BR2_PACKAGE_SAMBA4
	help
	  HTTPS setup, status, and fixed-operation control service for
	  qbtOS.

comment "qbtOS manager needs a toolchain w/ threads, wchar, dynamic library"
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS

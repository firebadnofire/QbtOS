CONFIG_ENV_IS_NOWHERE=n
CONFIG_ENV_IS_IN_FAT=n
CONFIG_ENV_IS_IN_EXT4=n
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_OFFSET=0x30000000
CONFIG_ENV_OFFSET_REDUND=0x30004000
CONFIG_ENV_REDUNDANT=y
CONFIG_ENV_SIZE=0x4000
CONFIG_CMD_EXT4=y
CONFIG_CMD_PART=y
CONFIG_CMD_FS_UUID=y
CONFIG_CMD_SAVEENV=y
CONFIG_BOOTDELAY=3
# Keep fatal exceptions visible on the development UART instead of rebooting.
CONFIG_PANIC_HANG=y
# Reinitialize PL011 before driver-model serial so pre-relocation failures are
# visible at the documented 115200 baud on Raspberry Pi 4 GPIO pins 14/15.
CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_PL011=y
CONFIG_DEBUG_UART_BASE=0xfe201000
CONFIG_DEBUG_UART_CLOCK=48000000
CONFIG_DEBUG_UART_ANNOUNCE=y
# qbtOS uses its explicit A/B boot script, not UEFI. Keeping EFI enabled also
# makes pre-relocation exception recovery consult state that is not initialized
# until BSS relocation on this platform.
CONFIG_EFI_LOADER=n
